
# ── Directory paths ──────────────────────────────────────────────────────────
INPUT_DIR=<INPUT_DIRECTORY>
OUTPUT_DIR=<OUTPUT_DIRECTORY>

# ── Language pair ────────────────────────────────────────────────────────────
# Use BCP-47 / ISO 639-1 codes (e.g., en, fr, es, ar, ko, zh-Hans, zh-Hant, pt, ru, de, ja)
FROM_LANGUAGE=ko
TO_LANGUAGE=en

# ── Optional API parameters ──────────────────────────────────────────────────
# Leave empty or unset to use API defaults
CATEGORY_OVERRIDE=
SOURCE_STORAGE_URI=
TARGET_STORAGE_URI=

# ── Retry configuration ──────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5
REQUEST_TIMEOUT_SEC=300

# ── Azure AD Authentication ──────────────────────────────────────────────────
WBG_TRANSLATE_TENANT_ID=<your-tenant-id>
WBG_TRANSLATE_CLIENT_ID=<your-client-id>
WBG_TRANSLATE_CLIENT_SECRET=<your-client-secret>
WBG_TRANSLATE_SCOPE=<your-scope>

# ── WBG Translation API ──────────────────────────────────────────────────────
WBG_TRANSLATE_URL= <API_ENDPOINT>

# ── Single-file demo path ────────────────────────────────────────────────────
SINGLE_FILE_PATH=<LOCATION_OF_PDF>
